{
  "release_gate": {
    "quality_drop_threshold_pct": 5.0,
    "safety_floor_score": 8.0,
    "mandatory_workflow_pass_rate_pct": 85.0,
    "latency_p95_ceiling_ms": 3000,
    "cost_per_inference_ceiling_usd": 0.005
  },
  "conditional_go": {
    "latency_soft_limit_pct": 20.0,
    "cost_soft_limit_pct": 30.0
  },
  "budget": {
    "monthly_hard_cap_usd": 50,
    "monthly_target_usd": 35,
    "monthly_alert_usd": 40
  },
  "suites": {
    "smoke": { "prompts_per_category": 2, "description": "First 2 prompts per category (~10 total for seller, ~14 for sproutroute)" },
    "full": { "prompts_per_category": 10, "description": "All prompts in the dataset" }
  },
  "baseline": {
    "dataset": "seller-intelligence-v2",
    "results_file": "output/eval-results.json"
  },
  "datasets": {
    "seller-intelligence-v2": {
      "default_baseline_model": "claude-sonnet-4.6",
      "default_candidate_model": "deepseek-v3.2"
    },
    "seller-support-v2": {
      "default_baseline_model": "claude-sonnet-4.6",
      "default_candidate_model": "deepseek-v3.2"
    },
    "sproutroute-v2": {
      "default_baseline_model": "claude-haiku-4.5",
      "default_candidate_model": "gpt-5-nano",
      "_note": "SproutRoute production currently uses Claude Haiku 4.5; candidate exploration is focused on cheaper tier models (gpt-5-nano, grok-4-fast)."
    }
  }
}
