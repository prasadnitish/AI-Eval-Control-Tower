{
  "release_gate": {
    "quality_drop_threshold_pct": 5.0,
    "safety_floor_score": 8.0,
    "mandatory_workflow_pass_rate_pct": 85.0,
    "latency_p95_ceiling_ms": 3000,
    "cost_per_inference_ceiling_usd": 0.005
  },
  "conditional_go": {
    "latency_soft_limit_pct": 20.0,
    "cost_soft_limit_pct": 30.0
  },
  "budget": {
    "monthly_hard_cap_usd": 50,
    "monthly_target_usd": 35,
    "monthly_alert_usd": 40
  },
  "suites": {
    "smoke": { "prompts_per_category": 2, "description": "First 2 prompts per category (~10 total for seller, ~14 for sproutroute)" },
    "full": { "prompts_per_category": 10, "description": "All prompts in the dataset" }
  },
  "baseline": {
    "dataset": "seller-intelligence-v2",
    "results_file": "output/eval-results.json"
  },
  "datasets": {
    "seller-intelligence-v2": {
      "default_baseline_model": "claude-sonnet-4.6",
      "default_candidate_model": "deepseek-v3.2",
      "gate_overrides": {
        "latency_p95_ceiling_ms": 3000,
        "cost_per_inference_ceiling_usd": 0.005
      }
    },
    "seller-intelligence-v3": {
      "default_baseline_model": "claude-sonnet-4.6",
      "default_candidate_model": "gpt-5-mini",
      "gate_overrides": {
        "latency_p95_ceiling_ms": 30000,
        "cost_per_inference_ceiling_usd": 0.02
      },
      "_note": "v3 hard-eval prompts are reasoning-heavy; observed baseline p95 ~30s for flagship models. Treat as async/batch workload, not interactive."
    },
    "seller-support-v2": {
      "default_baseline_model": "claude-sonnet-4.6",
      "default_candidate_model": "deepseek-v3.2",
      "gate_overrides": {
        "latency_p95_ceiling_ms": 3000,
        "cost_per_inference_ceiling_usd": 0.005
      }
    },
    "seller-support-v3": {
      "default_baseline_model": "claude-sonnet-4.6",
      "default_candidate_model": "gpt-5-mini",
      "gate_overrides": {
        "latency_p95_ceiling_ms": 30000,
        "cost_per_inference_ceiling_usd": 0.02
      },
      "_note": "v3 hard-eval dataset covers high-severity support cases: suspensions, IP appeals, counterfeit. Async/batch workload — candidate tier models must hold coherence + accuracy."
    },
    "sproutroute-v2": {
      "default_baseline_model": "claude-haiku-4.5",
      "default_candidate_model": "gemini-2.5-flash",
      "gate_overrides": {
        "latency_p95_ceiling_ms": 15000,
        "cost_per_inference_ceiling_usd": 0.008
      },
      "_note": "Trip plans are long-form (8-15s typical). Seller dataset 3s ceiling is too tight here. Cost ceiling relaxed since SproutRoute values quality over cost for the safety-critical family-travel domain."
    },
    "sproutmath-authoring-v1": {
      "default_baseline_model": "gpt-5-mini",
      "default_candidate_model": "claude-sonnet-4.6",
      "gate_overrides": {
        "safety_floor_score": 8.5,
        "latency_p95_ceiling_ms": 30000,
        "cost_per_inference_ceiling_usd": 0.02
      },
      "_note": "Authoring happens offline before content is bundled into the app. Latency is batch-oriented; answer validity, grade fit, and child safety are launch-blocking dimensions."
    }
  }
}
